table Operations
	lineageTag: aa1d75a0-3782-434e-8356-fe79996c66f2

	measure 'Nombre operations' = COALESCE(SUM(Operations[Nombre]), 0)
		formatString: #,0
		lineageTag: 01b83977-d01e-493c-988d-6f90dc593614

	measure 'Montant total' = IF(HASONEVALUE(Operations[Devise]), SUM(Operations[Montant]), BLANK())
		formatString: #,0.00
		lineageTag: 8a9a9019-92cf-49a6-b42a-5abf29feadcd

	measure 'Montant moyen' = DIVIDE([Montant total], [Nombre operations])
		formatString: #,0.00
		lineageTag: 0cb9f106-feb1-4ec3-ade9-3b2d67b1d8fe

	measure 'Montant minimum' = IF(HASONEVALUE(Operations[Devise]), MIN(Operations[Minimum]), BLANK())
		formatString: #,0.00
		lineageTag: 16ea2bd6-eb88-4a8b-b514-6e233f79bc2b

	measure 'Montant maximum' = IF(HASONEVALUE(Operations[Devise]), MAX(Operations[Maximum]), BLANK())
		formatString: #,0.00
		lineageTag: 964d0f13-1e60-419c-839b-f62866e15472

	measure 'Devise selectionnee' = SELECTEDVALUE(Operations[Devise], "Choisir une seule devise pour les montants")
		lineageTag: 2e108803-334c-464d-89a1-f18b797ce155

	measure 'Derniere publication' = MAX(Operations[Publication])
		formatString: dd/MM/yyyy HH:mm
		lineageTag: b5f81c7f-d30e-45fb-b078-ed90ba7415ce

	column Date
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: c5255646-9c4e-46ad-bf4e-6888231deb30
		summarizeBy: none
		sourceColumn: event_date

		annotation UnderlyingDateTimeDataType = Date

	column Devise
		dataType: string
		lineageTag: 53f53907-5942-44c7-a09f-182bf985aca5
		summarizeBy: none
		sourceColumn: currency

	column Type
		dataType: string
		lineageTag: 910183c7-ca00-431b-ab02-2de004796adb
		summarizeBy: none
		sourceColumn: operation_label

	column 'Code operation'
		dataType: string
		isHidden
		lineageTag: fd53345d-f59c-47df-8e2a-f119b078b96c
		summarizeBy: none
		sourceColumn: operation_type

	column Nombre
		dataType: int64
		isHidden
		lineageTag: a0f2c976-ed94-4023-85a1-b43431e66708
		summarizeBy: sum
		sourceColumn: operation_count

	column Montant
		dataType: double
		isHidden
		lineageTag: 62cfa551-cb18-4595-8e0e-fbf7860bfbec
		summarizeBy: sum
		sourceColumn: total_amount

	column Minimum
		dataType: double
		isHidden
		lineageTag: 59645eec-95af-4ff3-a70c-7ab05ff781d6
		summarizeBy: min
		sourceColumn: min_amount

	column Maximum
		dataType: double
		isHidden
		lineageTag: 90fc71b8-4b98-4d26-a085-78a4774f8652
		summarizeBy: max
		sourceColumn: max_amount

	column 'Total exact SQL'
		dataType: string
		lineageTag: 5e8512ca-448a-4792-a2a4-13a7c22aabc8
		summarizeBy: none
		sourceColumn: total_amount_exact

	column Publication
		dataType: dateTime
		lineageTag: fd52a5df-a084-4e79-96df-33c8272e45a1
		summarizeBy: none
		sourceColumn: computed_at

	column Execution
		dataType: string
		lineageTag: 2ea0a438-13ba-4a11-b1b3-209a73231e5e
		summarizeBy: none
		sourceColumn: run_id

	partition Operations = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(Serveur, Base, [CreateNavigationProperties=false]),
				    Data = Source{[Schema="analytics", Item="bi_daily_operations"]}[Data],
				    UTC = Table.TransformColumns(Data, {{"computed_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type datetime}})
				in
				    UTC

