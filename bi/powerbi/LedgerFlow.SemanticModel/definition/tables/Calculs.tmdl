	partition Calculs = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(Serveur, Base, [CreateNavigationProperties=false]),
				    Data = Source{[Schema="analytics", Item="bi_batch_runs"]}[Data],
				    UTC = Table.TransformColumns(Data, {
				        {"started_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type datetime},
				        {"finished_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type datetime}})
				in
				    UTC

