# Local development defaults are provided in compose.ops.yaml.
# Optional overrides: copy to .env.ops and add --env-file .env.ops to commands.
BATCH_WORKER_TOKEN=replace-with-at-least-24-random-characters
DASHBOARD_DB_PASSWORD=replace-with-a-long-database-password
BI_DB_PASSWORD=replace-with-a-long-bi-reader-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-admin-password
# AIRFLOW_DB_PASSWORD must be URL-safe because it is included in a database URL.
AIRFLOW_DB_PASSWORD=replace-with-a-url-safe-password
AIRFLOW_JWT_SECRET=replace-with-a-long-random-secret
ALERT_PENDING_COUNT=100
ALERT_PENDING_SECONDS=120
ALERT_UNPROCESSED_COUNT=100
ALERT_KAFKA_LAG=100
ABANDONED_RUN_SECONDS=7200
BATCH_DEADLINE_UTC_HOUR=4
# Defaults deliver emails to the local Mailpit inbox, not a real mailbox.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
ALERT_EMAIL_FROM=ledgerflow@example.test
ALERT_EMAIL_TO=operator@example.test
# Configure an external SMTP server OR a generic JSON webhook as needed.
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ALERT_WEBHOOK_URL=
