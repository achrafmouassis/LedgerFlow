{
  "uid": "ledgerflow-operations",
  "title": "LedgerFlow — surveillance et incidents",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "LedgerFlow"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Messages en attente d’envoi",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ledgerflow-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ledgerflow-postgres"
          },
          "rawSql": "SELECT sampled_at AS time,pending AS value FROM analytics.monitor_samples WHERE $__timeFilter(sampled_at) ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Retard de lecture Kafka",
      "type": "timeseries",
      "description": "Une interruption du graphique signifie que le retard est inconnu ; consulter les alertes.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ledgerflow-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ledgerflow-postgres"
          },
          "rawSql": "SELECT sampled_at AS time,NULLIF(kafka_lag,-1) AS value FROM analytics.monitor_samples WHERE $__timeFilter(sampled_at) ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
