    {
      "id": 7,
      "title": "Alertes — état et envoi des notifications",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ledgerflow-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ledgerflow-postgres"
          },
          "rawSql": "SELECT alert_key AS \"Contrôle\",active AS \"En alerte\",message AS \"Description\",changed_at AS \"Depuis\",notified_at AS \"Notification envoyée\" FROM analytics.alerts ORDER BY active DESC,changed_at DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "title": "Messages rejetés — identifiants pour le rejeu",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ledgerflow-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ledgerflow-postgres"
          },
          "rawSql": "SELECT id AS \"Identifiant\",status AS \"État\",topic AS \"Topic\",captured_at AS \"Reçu à\",replay_count AS \"Tentatives\",resolved_at AS \"Résolu à\" FROM analytics.dead_letter_overview ORDER BY captured_at DESC LIMIT 100",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
