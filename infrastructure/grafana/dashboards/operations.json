    {
      "id": 4,
      "title": "Âge du dernier contrôle (secondes)",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "ledgerflow-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ledgerflow-postgres"
          },
          "rawSql": "SELECT EXTRACT(EPOCH FROM clock_timestamp()-MAX(sampled_at)) AS value FROM analytics.monitor_samples",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "Aucune mesure"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
